<link rel="icon" type="image/png" sizes="512x512" href="/icons/icon-512x512.png">

<title>SLTimer — Palista</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f4f4f4;min-height:100vh;-webkit-tap-highlight-color:transparent}

/* ── Topbar ── */
.topbar{background:#fff;border-bottom:0.5px solid rgba(0,0,0,0.12);padding:12px 16px;display:flex;align-items:center;gap:8px;position:sticky;top:0;z-index:10}
.back{font-size:24px;color:#666;background:none;border:none;cursor:pointer;padding:0 4px;line-height:1;flex-shrink:0}
.back:active{opacity:.6}
.topbar h1{font-size:16px;font-weight:600;color:#111;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.btn-save{background:#185FA5;border:none;color:#fff;font-size:14px;font-weight:600;padding:8px 18px;border-radius:10px;cursor:pointer;font-family:inherit;transition:opacity .12s;flex-shrink:0}
.btn-save:active{opacity:.8}
.btn-save:disabled{opacity:.4;cursor:not-allowed}

/* ── Layout ── */
.content{padding:16px;display:flex;flex-direction:column;gap:16px;max-width:480px;margin:0 auto;padding-bottom:40px}

/* ── Avatar ── */
.avatar-wrap{display:flex;justify-content:center;padding:8px 0 4px}
.avatar{width:76px;height:76px;border-radius:50%;background:#E6F1FB;color:#0C447C;font-size:26px;font-weight:700;display:flex;align-items:center;justify-content:center;border:0.5px solid #B5D4F4;letter-spacing:-1px;transition:background .2s}

/* ── Section label ── */
.section-label{font-size:11px;font-weight:700;color:#aaa;text-transform:uppercase;letter-spacing:0.06em;padding:0 2px}

/* ── Card ── */
.card{background:#fff;border:0.5px solid rgba(0,0,0,0.10);border-radius:14px;overflow:hidden}

/* ── Field rows ── */
.field-row{padding:12px 16px;display:flex;flex-direction:column;gap:5px}
.field-row+.field-row{border-top:0.5px solid #f2f2f2}
.field-label{font-size:11px;font-weight:700;color:#888;text-transform:uppercase;letter-spacing:0.04em}
.field-label .opt{font-weight:400;color:#bbb;text-transform:none;letter-spacing:0;font-size:11px}
.field-input{border:none;outline:none;font-size:15px;color:#111;background:transparent;font-family:inherit;width:100%;padding:0;-webkit-appearance:none}
.field-input::placeholder{color:#ccc}
.field-input[type="date"]{color:#111}
.field-input[type="date"]:not([value=""]):valid{color:#111}

/* ── Sexo ── */
.sex-row{display:flex;gap:8px;margin-top:2px}
.sex-btn{flex:1;padding:9px 6px;border-radius:10px;border:0.5px solid #ddd;background:#fff;font-size:13px;font-weight:600;color:#888;cursor:pointer;font-family:inherit;transition:all .12s}
.sex-btn.active{background:#E6F1FB;border-color:#185FA5;color:#0C447C}
.sex-btn:active{opacity:.75}

/* ── Categorías ── */
.cat-row{display:flex;gap:8px;margin-top:4px;flex-wrap:wrap}
.cat-btn{padding:9px 20px;border-radius:10px;border:0.5px solid #ddd;background:#fff;font-size:14px;font-weight:700;color:#aaa;cursor:pointer;font-family:inherit;transition:all .15s;letter-spacing:0.03em}
.cat-btn:active{opacity:.75}
.cat-btn.k1.active{background:#E6F1FB;border-color:#185FA5;color:#0C447C}
.cat-btn.c1.active{background:#E1F5EE;border-color:#0F6E56;color:#085041}
.cat-btn.kxc.active{background:#FAEEDA;border-color:#854F0B;color:#633806}
.cat-desc{font-size:12px;color:#bbb;margin-top:6px}
.cat-desc span{font-weight:600}

/* ── Acceso / compartir ── */
.access-row{display:flex;align-items:center;gap:12px;padding:12px 16px}
.access-row+.access-row,.share-input-area,.shared-item{border-top:0.5px solid #f2f2f2}
.mini-avatar{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex-shrink:0;text-transform:uppercase}
.mini-avatar.owner{background:#E6F1FB;color:#0C447C}
.mini-avatar.shared{background:#f0f0f0;color:#666}
.access-info{flex:1;min-width:0}
.access-name{font-size:14px;font-weight:600;color:#111;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.access-sub{font-size:12px;color:#aaa;margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.badge-owner{font-size:11px;font-weight:700;background:#E6F1FB;color:#0C447C;padding:3px 9px;border-radius:100px;white-space:nowrap}
.btn-add{background:none;border:0.5px solid #185FA5;color:#185FA5;font-size:13px;font-weight:600;padding:7px 14px;border-radius:10px;cursor:pointer;font-family:inherit;white-space:nowrap}
.btn-add:active{background:#E6F1FB}
.share-input-area{padding:12px 16px;display:none}
.share-input-inner{display:flex;gap:8px}
.share-email-input{flex:1;border:0.5px solid #ddd;border-radius:8px;padding:10px 12px;font-size:14px;color:#111;font-family:inherit;outline:none;background:#fff;-webkit-appearance:none}
.share-email-input:focus{border-color:#185FA5}
.share-email-input::placeholder{color:#ccc}
.btn-share-confirm{background:#185FA5;border:none;color:#fff;font-size:14px;font-weight:600;padding:10px 16px;border-radius:8px;cursor:pointer;font-family:inherit;white-space:nowrap}
.btn-share-confirm:active{opacity:.8}
.shared-item{display:flex;align-items:center;gap:12px;padding:11px 16px}
.btn-revoke{background:none;border:none;color:#A32D2D;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;padding:5px 8px;border-radius:6px;white-space:nowrap}
.btn-revoke:active{background:#FCEBEB}

/* ── Toast ── */
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#1B3A5C;color:#fff;padding:10px 20px;border-radius:100px;font-size:14px;font-weight:600;opacity:0;transition:opacity .2s;pointer-events:none;z-index:99;white-space:nowrap;max-width:90vw;text-align:center}
.toast.show{opacity:1}
.toast.err{background:#A32D2D}
.toast.ok{background:#0F6E56}

/* ── Loading overlay ── */
.overlay{position:fixed;inset:0;background:rgba(255,255,255,.88);display:none;align-items:center;justify-content:center;z-index:999;flex-direction:column;gap:12px}
.overlay.show{display:flex}
.spinner{width:22px;height:22px;border:2px solid #ddd;border-top-color:#185FA5;border-radius:50%;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.overlay p{font-size:14px;color:#666}

/* ── Delete button (solo en modo edición) ── */
.btn-delete{width:100%;padding:13px;border-radius:12px;font-size:15px;font-weight:600;cursor:pointer;border:0.5px solid #F7C1C1;background:#FCEBEB;color:#A32D2D;font-family:inherit;transition:opacity .12s}
.btn-delete:active{opacity:.75}
</style>
</head>
<body>

<div class="overlay" id="overlay"><div class="spinner"></div><p id="overlay-msg">Guardando...</p></div>

<!-- ══ TOPBAR ══ -->
<div class="topbar">
  <button class="back" onclick="goBack()">←</button>
  <h1 id="page-title">Nuevo palista</h1>
  <button class="btn-save" id="btn-save" onclick="savePalista()">Guardar</button>
</div>

<!-- ══ CONTENIDO ══ -->
<div class="content">

  <!-- Avatar generado con iniciales -->
  <div class="avatar-wrap">
    <div class="avatar" id="avatar">?</div>
  </div>

  <!-- ── Datos personales ── -->
  <div class="section-label">Datos personales</div>
  <div class="card">
    <div class="field-row">
      <div class="field-label">Nombre</div>
      <input class="field-input" id="inp-name" type="text" placeholder="Ej: Carlos" autocomplete="given-name" oninput="updateAvatar()">
    </div>
    <div class="field-row">
      <div class="field-label">Apellido <span class="opt">(opcional)</span></div>
      <input class="field-input" id="inp-surname" type="text" placeholder="Ej: García" autocomplete="family-name" oninput="updateAvatar()">
    </div>
    <div class="field-row">
      <div class="field-label">Fecha de nacimiento <span class="opt">(opcional)</span></div>
      <input class="field-input" id="inp-dob" type="date">
    </div>
    <div class="field-row">
      <div class="field-label">Sexo</div>
      <div class="sex-row">
        <button class="sex-btn" onclick="setSex(this,'M')">Masculino</button>
        <button class="sex-btn" onclick="setSex(this,'F')">Femenino</button>
        <button class="sex-btn" onclick="setSex(this,'O')">Otro</button>
      </div>
    </div>
  </div>

  <!-- ── Categorías ── -->
  <div class="section-label">Categorías</div>
  <div class="card">
    <div class="field-row">
      <div class="field-label">Modalidades en las que compite</div>
      <div class="cat-row">
        <button class="cat-btn k1"  onclick="toggleCat(this,'K1')">K1</button>
        <button class="cat-btn c1"  onclick="toggleCat(this,'C1')">C1</button>
        <button class="cat-btn kxc" onclick="toggleCat(this,'KXC')">KXC</button>
      </div>
      <div class="cat-desc" id="cat-desc">Selecciona al menos una modalidad</div>
    </div>
  </div>

  <!-- ── Acceso ── -->
  <div class="section-label">Acceso</div>
  <div class="card" id="access-card">
    <!-- Fila del propietario -->
    <div class="access-row">
      <div class="mini-avatar owner" id="owner-avatar"></div>
      <div class="access-info">
        <div class="access-name" id="owner-name">Tú</div>
        <div class="access-sub" id="owner-email"></div>
      </div>
      <span class="badge-owner">Propietario</span>
    </div>
    <!-- Fila de añadir -->
    <div class="access-row">
      <div class="access-info">
        <div class="access-name">Compartir con entrenador</div>
        <div class="access-sub">Busca por dirección de email</div>
      </div>
      <button class="btn-add" onclick="toggleShareInput()">+ Añadir</button>
    </div>
    <!-- Input de email -->
    <div class="share-input-area" id="share-input-area">
      <div class="share-input-inner">
        <input class="share-email-input" id="share-email" type="email" placeholder="email@entrenador.com">
        <button class="btn-share-confirm" onclick="addShared()">Añadir</button>
      </div>
    </div>
    <!-- Lista de accesos compartidos -->
    <div id="shared-list"></div>
  </div>

  <!-- Botón eliminar (solo en modo edición) -->
  <button class="btn-delete" id="btn-delete" style="display:none" onclick="confirmDelete()">Eliminar palista</button>

</div>

<div class="toast" id="toast"></div>

<script>
// ── CONFIGURACIÓN ─────────────────────────────────────────────────────────────
const SB  = 'https://duwmhatcqxlwtqdnzhle.supabase.co';
const KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImR1d21oYXRjcXhsd3RxZG56aGxlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzc3MzIwMDMsImV4cCI6MjA5MzMwODAwM30.CkvnBvuo8rS2cv1Uts6dmUATUMbW9Dgjg4L29HE9Wdo';

// ── Estado ────────────────────────────────────────────────────────────────────
let _tok   = null;
let _uid   = null;
let _email = null;
let _athleteId = null;   // null = nuevo, uuid = editar existente
let _sex   = null;
let _cats  = new Set();  // Set de 'K1','C1','KXC'
let _shared = [];        // [{email, id (si ya existe en BD)}]

const $ = id => document.getElementById(id);

// ── UI helpers ────────────────────────────────────────────────────────────────
function showLoad(msg = 'Guardando...') {
  $('overlay-msg').textContent = msg;
  $('overlay').classList.add('show');
}
function hideLoad() { $('overlay').classList.remove('show'); }

let _tTimer;
function toast(msg, type = '') {
  const el = $('toast');
  el.textContent = msg;
  el.className = 'toast' + (type ? ' ' + type : '');
  el.classList.add('show');
  clearTimeout(_tTimer);
  _tTimer = setTimeout(() => el.classList.remove('show'), 3000);
}

function initials(name, surname) {
  const a = name?.trim()[0] || '';
  const b = surname?.trim()[0] || name?.trim()[1] || '';
  return (a + b).toUpperCase() || '?';
}

// ── Avatar dinámico ───────────────────────────────────────────────────────────
function updateAvatar() {
  const n = $('inp-name').value;
  const s = $('inp-surname').value;
  $('avatar').textContent = initials(n, s);
}

// ── Sexo ──────────────────────────────────────────────────────────────────────
function setSex(btn, val) {
  _sex = val;
  document.querySelectorAll('.sex-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
}

// ── Categorías ────────────────────────────────────────────────────────────────
const CAT_LABELS = { K1: 'Kayak', C1: 'Canoa', KXC: 'Kayak Cross' };

function toggleCat(btn, cat) {
  if (_cats.has(cat)) {
    _cats.delete(cat);
    btn.classList.remove('active');
  } else {
    _cats.add(cat);
    btn.classList.add('active');
  }
  updateCatDesc();
}

function updateCatDesc() {
  const desc = $('cat-desc');
  if (_cats.size === 0) {
    desc.textContent = 'Selecciona al menos una modalidad';
    desc.style.color = '#bbb';
  } else {
    const labels = [..._cats].map(c => `${c} — ${CAT_LABELS[c]}`).join('  ·  ');
    desc.textContent = labels;
    desc.style.color = '#888';
  }
}

// ── Compartir ─────────────────────────────────────────────────────────────────
function toggleShareInput() {
  const area = $('share-input-area');
  const open = area.style.display === 'block';
  area.style.display = open ? 'none' : 'block';
  if (!open) $('share-email').focus();
}

function addShared() {
  const email = $('share-email').value.trim().toLowerCase();
  if (!email || !email.includes('@')) { toast('Email no válido', 'err'); return; }
  if (email === _email) { toast('Eres el propietario', 'err'); return; }
  if (_shared.find(s => s.email === email)) { toast('Ya tiene acceso', 'err'); return; }
  _shared.push({ email, id: null });
  $('share-email').value = '';
  $('share-input-area').style.display = 'none';
  renderShared();
}

function removeShared(email) {
  _shared = _shared.filter(s => s.email !== email);
  renderShared();
}

function renderShared() {
  const list = $('shared-list');
  if (_shared.length === 0) { list.innerHTML = ''; return; }
  list.innerHTML = _shared.map(s => `
    <div class="shared-item">
      <div class="mini-avatar shared">${s.email.slice(0,2).toUpperCase()}</div>
      <div class="access-info">
        <div class="access-name">${s.email}</div>
        <div class="access-sub">Puede usar en sesiones · Puede compartir</div>
      </div>
      <button class="btn-revoke" onclick="removeShared('${s.email}')">Quitar</button>
    </div>
  `).join('');
}

// ── API helper ────────────────────────────────────────────────────────────────
async function api(path, opts = {}) {
  const h = {
    'apikey': KEY,
    'Content-Type': 'application/json',
    'Authorization': 'Bearer ' + _tok,
    ...(opts.headers || {})
  };
  const r = await fetch(SB + path, { ...opts, headers: h });
  const t = await r.text();
  let j; try { j = JSON.parse(t); } catch { j = t; }
  if (!r.ok) throw new Error(j?.message || j?.hint || JSON.stringify(j));
  return j;
}

// ── Guardar ───────────────────────────────────────────────────────────────────
async function savePalista() {
  const name = $('inp-name').value.trim();
  if (!name) { toast('El nombre es obligatorio', 'err'); return; }
  if (_cats.size === 0) { toast('Selecciona al menos una categoría', 'err'); return; }

  const payload = {
    name,
    surname:    $('inp-surname').value.trim() || null,
    birth_date: $('inp-dob').value || null,
    sex:        _sex,
    categories: [..._cats],
    owner_id:   _uid
  };

  showLoad(_athleteId ? 'Guardando cambios...' : 'Creando palista...');
  $('btn-save').disabled = true;

  try {
    let athleteId = _athleteId;

    if (!athleteId) {
      // Crear nuevo
      const res = await api('/rest/v1/athletes', {
        method: 'POST',
        headers: { 'Prefer': 'return=representation' },
        body: JSON.stringify(payload)
      });
      athleteId = res[0].id;
    } else {
      // Actualizar existente
      await api(`/rest/v1/athletes?id=eq.${athleteId}`, {
        method: 'PATCH',
        body: JSON.stringify(payload)
      });
    }

    // Sincronizar accesos compartidos
    await syncSharedAccess(athleteId);

    hideLoad();
    toast(_athleteId ? 'Cambios guardados' : 'Palista creado', 'ok');
    setTimeout(() => window.location.href = 'athletes.html', 1200);

  } catch (e) {
    hideLoad();
    $('btn-save').disabled = false;
    toast(e.message, 'err');
  }
}

// ── Sincronizar accesos ───────────────────────────────────────────────────────
async function syncSharedAccess(athleteId) {
  // 1. Obtener los accesos actuales en BD
  let existing = [];
  try {
    existing = await api(`/rest/v1/athlete_access?athlete_id=eq.${athleteId}&select=id,trainer_id`);
  } catch {}

  // 2. Buscar los trainer_id de los emails nuevos
  for (const s of _shared) {
    if (s.id) continue; // ya existe en BD, nada que hacer
    try {
      // Buscar el uid del entrenador por email
      const users = await api(`/rest/v1/rpc/get_user_id_by_email`, {
        method: 'POST',
        body: JSON.stringify({ p_email: s.email })
      });
      if (!users?.user_id) continue;

      // Insertar acceso
      await api('/rest/v1/athlete_access', {
        method: 'POST',
        body: JSON.stringify({
          athlete_id:  athleteId,
          trainer_id:  users.user_id,
          granted_by:  _uid,
          can_share:   true
        })
      });
    } catch { /* El entrenador no existe o ya tiene acceso */ }
  }

  // 3. Revocar los que se quitaron de la lista
  const keptEmails = _shared.map(s => s.email);
  for (const ex of existing) {
    const stillPresent = _shared.find(s => s.id === ex.id);
    if (!stillPresent) {
      try {
        await api(`/rest/v1/athlete_access?id=eq.${ex.id}`, { method: 'DELETE' });
      } catch {}
    }
  }
}

// ── Eliminar palista ──────────────────────────────────────────────────────────
async function confirmDelete() {
  if (!confirm('¿Eliminar este palista? Los tiempos registrados se conservarán en las sesiones.')) return;
  showLoad('Eliminando...');
  try {
    await api(`/rest/v1/athletes?id=eq.${_athleteId}`, { method: 'DELETE' });
    hideLoad();
    toast('Palista eliminado', 'ok');
    setTimeout(() => window.location.href = 'athletes.html', 1000);
  } catch (e) {
    hideLoad();
    toast(e.message, 'err');
  }
}

// ── Navegación ────────────────────────────────────────────────────────────────
function goBack() {
  window.location.href = 'athletes.html';
}

// ── Cargar datos existentes (modo edición) ────────────────────────────────────
async function loadAthlete(id) {
  showLoad('Cargando...');
  try {
    const rows = await api(`/rest/v1/athletes?id=eq.${id}&select=*`);
    if (!rows || rows.length === 0) throw new Error('Palista no encontrado');
    const a = rows[0];

    $('page-title').textContent = a.name + (a.surname ? ' ' + a.surname : '');
    $('inp-name').value    = a.name || '';
    $('inp-surname').value = a.surname || '';
    $('inp-dob').value     = a.birth_date || '';
    updateAvatar();

    if (a.sex) {
      const map = { M: 0, F: 1, O: 2 };
      const btns = document.querySelectorAll('.sex-btn');
      if (btns[map[a.sex]]) setSex(btns[map[a.sex]], a.sex);
    }

    if (a.categories) {
      a.categories.forEach(cat => {
        const btn = document.querySelector(`.cat-btn.${cat.toLowerCase()}`);
        if (btn) toggleCat(btn, cat);
      });
    }

    // Cargar accesos compartidos
    const accesses = await api(
      `/rest/v1/athlete_access?athlete_id=eq.${id}&select=id,trainer_id`
    );
    // Necesitamos los emails — usamos la función RPC
    for (const ac of accesses) {
      if (ac.trainer_id === _uid) continue; // skip owner
      try {
        const res = await api('/rest/v1/rpc/get_email_by_user_id', {
          method: 'POST',
          body: JSON.stringify({ p_user_id: ac.trainer_id })
        });
        if (res?.email) _shared.push({ email: res.email, id: ac.id });
      } catch {}
    }
    renderShared();

    // Mostrar botón eliminar
    $('btn-delete').style.display = 'block';

    hideLoad();
  } catch (e) {
    hideLoad();
    toast(e.message, 'err');
  }
}

// ── Init ──────────────────────────────────────────────────────────────────────
window.addEventListener('DOMContentLoaded', async () => {
  _tok   = localStorage.getItem('slt_tok');
  _uid   = localStorage.getItem('slt_uid');
  _email = localStorage.getItem('slt_email');

  if (!_tok) { window.location.href = 'index.html'; return; }

  // Mostrar datos del propietario
  const ini = _email ? _email.slice(0, 2).toUpperCase() : 'YO';
  $('owner-avatar').textContent = ini;
  $('owner-email').textContent  = _email || '';

  // ¿Modo edición? Leer ?id=xxx de la URL
  const params = new URLSearchParams(window.location.search);
  _athleteId = params.get('id') || null;

  if (_athleteId) {
    $('page-title').textContent = 'Editar palista';
    await loadAthlete(_athleteId);
  }
});

// PWA
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('/sw.js').catch(() => {});
}
</script>

